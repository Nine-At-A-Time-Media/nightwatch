{
  "name": "nightwatch",
  "version": "0.0.0",
  "private": true,
  "description": "Error tracking and bug reports with a closed reporter loop, on Cloudflare.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "mutate": "stryker run",
    "dev": "./scripts/dev.sh",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "jose": "^6.2.15",
    "zod": "^4.6.7"
  }
}
